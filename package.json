{
  "name": "sunset-isolines",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate": "node scripts/solar.mjs && .venv/bin/python scripts/clip.py && .venv/bin/python scripts/bands.py && npm run generate:atlas",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "prepare:data": "bash scripts/prepare.sh",
    "generate:atlas": ".venv/bin/python scripts/atlas-zones.py && node scripts/build-atlas.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "astronomy-engine": "2.1.19",
    "maplibre-gl": "5.14.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@playwright/test": "1.58.2",
    "earcut": "3.2.4",
    "geojson-vt": "4.0.3",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "vite": "6.4.1"
  }
}
